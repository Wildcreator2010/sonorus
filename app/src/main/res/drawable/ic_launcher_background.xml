<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的背景层：两档渐变直接取自 logo 源图对角线上的实际像素。
  前景按安全区缩进后，露出的底色与 logo 自身渐变接得上，不会围出一圈硬边。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#2A97ED"
        android:endColor="#ED652A" />
</shape>
