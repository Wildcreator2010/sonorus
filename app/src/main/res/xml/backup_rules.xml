<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 及以下：云备份 / 设备迁移规则。
  策略：先显式 include 需要迁移的非敏感数据，再 exclude 加密密钥库
  （Keystore 主密钥不可导出，跨设备恢复必然失败，且不应外传）。
  安全决策：聊天记录数据库 sonorus.db 为明文存储，不再参与云备份——
  换机时请通过应用内「导出会话」功能迁移对话内容。
  注意：exclude 的路径必须落在已 include 的范围内，否则 lint 会报 FullBackupContent。
-->
<full-backup-content>
    <include domain="file" path="datastore/" />
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="sonorus_secrets.xml" />
</full-backup-content>
